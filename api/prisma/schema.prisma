generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum BookStatus {
  WANT_TO_READ
  READING
  READ
}

model Book {
  id        String     @id @default(uuid())
  title     String
  author    String
  status    BookStatus
  rating    Int?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}
